# OpenSearch 検索 Web アプリ — 環境変数サンプル
# このファイルをコピーして .env を作成し、各値を環境に合わせて編集してください。
#
#   cp .env.example .env
#
# .env にはパスワード等の機密情報が含まれるため、
# .gitignore に追加してリポジトリにコミットしないこと。
# このファイル（.env.example）はパスワードを空欄にした雛形としてリポジトリに含めます。

# ─────────────────────────────────────────────
#  アプリ設定
# ─────────────────────────────────────────────

# アプリが Listen するポート番号（既定: 3000）
PORT=3000

# ─────────────────────────────────────────────
#  OpenSearch 接続設定
# ─────────────────────────────────────────────

# OpenSearch クラスタの URL（末尾スラッシュは不要）
# ローカル環境の例:
OPENSEARCH_URL=http://localhost:9200
# リモートクラスタの例:
# OPENSEARCH_URL=https://my-opensearch-cluster.example.com:9200

# 認証が必要なクラスタの場合のみ設定。
# 不要な場合（セキュリティプラグイン無効など）はコメントアウトのまま。
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=
